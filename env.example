# RockGPT deployment configuration.
#
# Copy this file to ".env" in the repository root and adjust the values:
#
#     cp env.example .env
#     chmod 600 .env
#
# Docker Compose reads ".env" automatically, so the whole stack is described by
# the repository plus this single file: no environment variables have to be
# exported by hand on the command line. ".env" is gitignored and must never be
# committed, because it holds the API keys.
#
# Every variable below is optional: the defaults in compose.yml are used when a
# variable is missing or empty.

# --- Image tags -------------------------------------------------------------
# Pin both tags explicitly. Open WebUI migrates its database forward on start
# and cannot migrate it back, so an accidental downgrade breaks the deployment.
OLLAMA_DOCKER_TAG=0.24.0
WEBUI_DOCKER_TAG=v0.11.3-cuda

# --- Host ports -------------------------------------------------------------
OPEN_WEBUI_PORT=8585
OLLAMA_PORT=11434

# --- Open WebUI -------------------------------------------------------------
# Authentication. "False" opens the interface directly on the preloaded admin
# account, with no login prompt: acceptable on a laptop, not on a host that is
# reachable from the network. Set it to "True" there.
#
# This is a one-way door. Once authentication is on the instance accumulates
# users, and Open WebUI refuses to start with authentication disabled and more
# than one user in the database. Backing out means restoring a backup of
# openwebui/rockgpt-open-webui/, not setting this back to "False".
WEBUI_AUTH=False

# Session signing key. Leave empty to let Open WebUI generate and persist one on
# first start. Set it explicitly to keep sessions valid across a redeployment
# with an empty data directory, e.g. openssl rand -hex 32
WEBUI_SECRET_KEY=

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
GLOBAL_LOG_LEVEL=INFO

# Default parameters applied to every model, as JSON.
#
# Open WebUI 0.11 changed the function calling default to "native": the tool
# list is attached to every request, and models without tool support fail hard.
# Ollama answers 400 "<model> does not support tools", an OpenAI-compatible
# gateway answers 500, and the user just sees an empty reply. "legacy" is the
# prompt-based mode used up to 0.9.x, and it works with every model.
#
# Careful: this only seeds a fresh database. On an existing deployment the value
# is already stored, and it has to be changed in the interface, under
# Admin Settings > Models > Model Defaults > Model Parameters > Function Calling.
DEFAULT_MODEL_PARAMS={"function_calling":"legacy"}

# Model used for background tasks (chat title, tags, follow-up questions) when
# the chat itself runs on an external, OpenAI-compatible backend.
#
# Empty means "reuse the chat model", but 0.11 forwards it as an empty model id
# and the gateway rejects it: the string "Model '' was not found" then shows up
# inside the reply. Name a small local model instead, e.g. phi4:latest.
#
# Same caveat as above: seeds a fresh database only. On an existing deployment,
# change it under Admin Settings > Interface > Tasks > External Task Model.
TASK_MODEL_EXTERNAL=

# --- Single sign-on (OIDC) ---------------------------------------------------
# Delegates authentication to an OpenID Connect provider. Leave the whole block
# empty to keep local accounts only; Open WebUI shows the SSO button as soon as
# OAUTH_CLIENT_ID, OAUTH_CLIENT_SECRET and OPENID_PROVIDER_URL are all set.
#
# The provider is used as an identity provider only. Roles stay in Open WebUI:
# ENABLE_OAUTH_ROLE_MANAGEMENT is not listed here on purpose, because enabling it
# recomputes the role from a token claim at every login and silently undoes any
# promotion made from the admin interface. Promote and demote under
# Admin Settings > Users instead.
#
# ⚠ Everything in this block is PersistentConfig: the values below seed the
# database on the first start that sees them, and from then on the stored value
# wins. On a running deployment, editing this file changes nothing — use
# Admin Settings > Authentication.

# Name shown on the login button, e.g. "Keycloak".
OAUTH_PROVIDER_NAME=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Discovery document. Mind the path: a Keycloak served under the legacy "/auth"
# prefix answers 404 on the modern one, and the failure surfaces late, as a
# generic login error.
#   modern: https://<host>/realms/<realm>/.well-known/openid-configuration
#   legacy: https://<host>/auth/realms/<realm>/.well-known/openid-configuration
OPENID_PROVIDER_URL=

# Must match a "Valid redirect URI" on the provider exactly, and must be the URL
# the browser reaches — the reverse proxy name, not the container port.
OPENID_REDIRECT_URI=

OAUTH_SCOPES=openid email profile

# Creates an Open WebUI account on a first SSO login. Without it, only people who
# already have a local account can use the button.
ENABLE_OAUTH_SIGNUP=True

# Role given to that new account. "pending" holds it in a waiting screen until an
# administrator promotes it: this is the access gate, since anyone in the realm
# can authenticate. Set it to "user" to let everyone in automatically.
DEFAULT_USER_ROLE=pending

# Shown to a pending account. The default text names no contact, so name one.
PENDING_USER_OVERLAY_TITLE=
PENDING_USER_OVERLAY_CONTENT=

# Lets an SSO login land on an existing local account with the same email instead
# of creating a duplicate. Only safe with a single provider that verifies email
# addresses; with several providers it is an account takeover vector.
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=True

# Comma-separated allow-list of email domains, "*" for any. A cheap second gate
# in case the provider is ever federated to an external directory.
OAUTH_ALLOWED_DOMAINS=*

# PKCE. Open WebUI sends no code_challenge unless this is set to S256. Set it
# here first, verify a login works, and only then make PKCE mandatory on the
# provider — doing it the other way round rejects every authorization request.
OAUTH_CODE_CHALLENGE_METHOD=

# Keeps the local email/password form next to the SSO button. Leave it on: it is
# the break-glass door, and Open WebUI has no password reset flow — it has no
# SMTP support at all — so an SSO outage with this off locks everyone out.
ENABLE_LOGIN_FORM=True

# --- Reverse proxy -----------------------------------------------------------
# Public base URL as the browser sees it. Open WebUI builds the OAuth redirect
# and scopes the session cookie from it.
WEBUI_URL=

# Mark the cookies "Secure" when the site is served over HTTPS. Both default to
# false, which is right for plain HTTP on localhost and wrong behind a TLS proxy.
# Do not also set SameSite to "strict": the OAuth callback arrives as a
# cross-site top-level navigation, the cookie is dropped, and the login loops.
WEBUI_SESSION_COOKIE_SECURE=False
WEBUI_AUTH_COOKIE_SECURE=False

# --- Optional OpenAI-compatible backend -------------------------------------
# Additional inference backend exposed alongside Ollama, e.g. an on-premise
# gateway. Leave both empty to run on Ollama only. Comma-separated lists are
# allowed, and the Nth key is paired with the Nth base URL.
OPENAI_API_BASE_URLS=
OPENAI_API_KEYS=
